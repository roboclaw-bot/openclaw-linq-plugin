{
  "name": "openclaw-linq-plugin",
  "version": "1.0.0",
  "description": "Linq iMessage channel plugin for OpenClaw — real iMessage over API, no Mac required",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run test:integration",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:integration": "node test/integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linq-team/openclaw-linq-plugin.git"
  },
  "keywords": [
    "openclaw",
    "linq",
    "imessage",
    "channel",
    "plugin",
    "sms",
    "messaging"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "5.0.4",
    "openclaw": "2026.10.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "linq",
      "label": "Linq",
      "selectionLabel": "Linq (Messaging API)",
      "blurb": "iMessage, RCS, and SMS through the Linq API.",
      "docsPath": "https://github.com/linq-team/openclaw-linq-plugin#readme",
      "configuredState": {
        "env": {
          "allOf": [
            "LINQ_API_TOKEN"
          ]
        }
      }
    },
    "compat": {
      "pluginApi": ">=2026.10.3"
    },
    "build": {
      "openclawVersion": "2026.10.3"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ]
}
